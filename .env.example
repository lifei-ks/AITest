# ===== 基础 =====
# SQLite 默认落在 ./data/aicase.db；也可切 MySQL：
# mysql+pymysql://user:pwd@host:3306/aicase?charset=utf8mb4
DATABASE_URL=sqlite:///./data/aicase.db

# 执行证据输出目录（截图 / 录屏 / 报告）
OUTPUT_DIR=./outputs

# 静态分析引擎：ast（默认，失败自动回退 regex） / regex
ANALYZER_ENGINE=ast

# 视觉审核图片预算
VISION_MAX_IMAGES=6
VISION_MAX_IMAGES_FAILED=10
VISION_TWO_PASS_REVIEW=true

# 被测站点默认地址（演示靶站）
TARGET_URL_DEFAULT=http://127.0.0.1:8200

# ===== 文本 LLM（初始配置）=====
# 首次读取设置时会迁移成数据库里的默认文本 profile；之后在设置页维护多套配置
# 留空则自动走纯规则模式，功能完整可用
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ===== 多模态 LLM（初始配置）=====
# 首次读取设置时会迁移成默认 VLM profile；没有可用 VLM 时回退默认文本 profile
# 用于：执行截图 AI 审核（逐图分析 / 红框定位 / 置信度）
LLM_VISION_API_KEY=
LLM_VISION_BASE_URL=
LLM_VISION_MODEL=
