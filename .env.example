# ===== 基础 =====
# SQLite 默认落在 ./data/aicase.db；也可切 MySQL：
# mysql+pymysql://user:pwd@host:3306/aicase?charset=utf8mb4
DATABASE_URL=sqlite:///./data/aicase.db

# 执行证据输出目录（截图 / 录屏 / 报告）
OUTPUT_DIR=./outputs

# 被测站点默认地址（演示靶站）
TARGET_URL_DEFAULT=http://127.0.0.1:8200

# ===== 文本 LLM =====
# 用于：需求测试点解析、用例生成
# 留空则自动走纯规则模式，功能完整可用
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ===== 多模态 LLM =====
# 用于：执行截图 AI 审核（逐图分析 / 红框定位 / 置信度）
# 任一项留空则自动回退到上面的文本 LLM 配置
LLM_VISION_API_KEY=
LLM_VISION_BASE_URL=
LLM_VISION_MODEL=
